<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!--
    Diálogo de historial de acciones de un tablero.
    Muestra en orden cronológico inverso todos los eventos registrados
    (mover tarjeta, añadir lista, bloquear tablero, etc.).
    Se abre como Stage modal desde BoardViewController.handleVerHistorial().
-->
<VBox spacing="12.0" prefWidth="500.0" prefHeight="400.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="es.um.pds.tableros.infrastructure.javafx.controllers.HistorialController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Historial de Acciones">
        <font><Font name="System Bold" size="16.0"/></font>
    </Label>

    <!-- Lista de eventos: cada item es un String formateado por el controlador -->
    <ListView fx:id="listHistorial" VBox.vgrow="ALWAYS"/>

    <Button text="Cerrar" onAction="#handleCerrar" maxWidth="Infinity"
            style="-fx-background-color: #ebecf0;"/>
</VBox>
