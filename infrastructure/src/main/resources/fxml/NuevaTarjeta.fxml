<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="12.0" prefWidth="420.0" prefHeight="450.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="es.um.pds.tableros.infrastructure.javafx.controllers.NuevaTarjetaController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Nueva Tarjeta">
        <font><Font name="System Bold" size="16.0"/></font>
    </Label>

    <Label text="Título *"/>
    <TextField fx:id="txtTitulo" promptText="Ej: Implementar login, Revisar PR..."/>

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label text="Tipo:"/>
        <ChoiceBox fx:id="cbTipo"/>
    </HBox>

    <Label text="Etiqueta (opcional):"/>
    <HBox spacing="8.0" alignment="CENTER_LEFT">
        <TextField fx:id="txtEtiqueta" promptText="Ej: Urgente, Bug, Frontend..."
                   HBox.hgrow="ALWAYS"/>
        <ColorPicker fx:id="cpColor" promptText="Color"/>
    </HBox>

    <VBox fx:id="sectionChecklist" spacing="8.0">
        <Label text="Pasos del Checklist:">
            <font><Font name="System Bold" size="12.0"/></font>
        </Label>
        <HBox spacing="8.0">
            <TextField fx:id="txtNuevoItem" promptText="Ej: Comprar el pan" HBox.hgrow="ALWAYS" onAction="#handleAnadirPaso"/>
            <Button text="+" onAction="#handleAnadirPaso" style="-fx-font-weight: bold;"/>
        </HBox>
        <ListView fx:id="listViewItems" prefHeight="100.0"/>
    </VBox>

    <HBox spacing="10.0" alignment="CENTER_RIGHT">
        <Button text="Cancelar" onAction="#handleCancelar"
                style="-fx-background-color: #ebecf0;"/>
        <Button text="Crear Tarjeta" onAction="#handleCrear"
                style="-fx-background-color: #0079bf; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>
</VBox>